  createdBy          User                        @relation("MobileEnrollmentTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy          User?                       @relation("MobileEnrollmentTokenRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  consumedByDevice   MobileDevice?               @relation("MobileEnrollmentTokenConsumedByDevice", fields: [consumedByDeviceId], references: [id], onDelete: SetNull)
  mobileAuthAuditEvents MobileAuthAuditEvent[]   @relation("MobileAuthAuditEventEnrollmentToken")

  @@index([groupId], map: "mobile_enrollment_tokens_group_id_idx")
  @@index([companyId], map: "mobile_enrollment_tokens_company_id_idx")
  @@index([locationId], map: "mobile_enrollment_tokens_location_id_idx")
  @@index([status], map: "mobile_enrollment_tokens_status_idx")
  @@index([expiresAt], map: "mobile_enrollment_tokens_expires_at_idx")
  @@index([createdByUserId], map: "mobile_enrollment_tokens_created_by_user_id_idx")
  @@index([consumedByDeviceId], map: "mobile_enrollment_tokens_consumed_by_device_id_idx")
  @@map("mobile_enrollment_tokens")
}

model MobileSession {
  id                String    @id @default(cuid())
  groupId           String
  companyId         String
  locationId        String
  deviceId          String
  employeeId        String
  tokenHash         String    @unique(map: "mobile_sessions_token_hash_key")
  tokenHashPrefix   String?
  expiresAt         DateTime
  lastSeenAt        DateTime?
  logoutAt          DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  revocationReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group             Group     @relation("MobileSessionGroup", fields: [groupId], references: [id], onDelete: Restrict)
  company           Company   @relation("MobileSessionCompany", fields: [companyId], references: [id], onDelete: Restrict)
  location          Location  @relation("MobileSessionLocation", fields: [locationId], references: [id], onDelete: Restrict)
  device            MobileDevice @relation("MobileSessionDevice", fields: [deviceId], references: [id], onDelete: Restrict)
  employee          Employee  @relation("MobileSessionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  revokedBy         User?     @relation("MobileSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  mobileAuthAuditEvents MobileAuthAuditEvent[] @relation("MobileAuthAuditEventSession")

  @@index([groupId], map: "mobile_sessions_group_id_idx")
  @@index([companyId], map: "mobile_sessions_company_id_idx")
  @@index([locationId], map: "mobile_sessions_location_id_idx")
  @@index([deviceId], map: "mobile_sessions_device_id_idx")
  @@index([employeeId], map: "mobile_sessions_employee_id_idx")
  @@index([expiresAt], map: "mobile_sessions_expires_at_idx")
  @@index([revokedAt], map: "mobile_sessions_revoked_at_idx")
  @@map("mobile_sessions")
}

model EmployeeBadgeCredential {
  id                 String    @id @default(cuid())
  groupId            String
  companyId          String
  locationId         String
  employeeId         String
  deviceId           String?
  badgeUidHash       String
  badgeUidHashPrefix String?
  label              String?
  lockedUntil        DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedByUserId    String?
  revocationReason   String?
  provisionedByUserId String
  provisionedAt      DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  group              Group     @relation("EmployeeBadgeCredentialGroup", fields: [groupId], references: [id], onDelete: Restrict)
  company            Company   @relation("EmployeeBadgeCredentialCompany", fields: [companyId], references: [id], onDelete: Restrict)
  location           Location  @relation("EmployeeBadgeCredentialLocation", fields: [locationId], references: [id], onDelete: Restrict)
  employee           Employee  @relation("EmployeeBadgeCredentialEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  device             MobileDevice? @relation("EmployeeBadgeCredentialDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  provisionedBy      User      @relation("EmployeeBadgeProvisionedBy", fields: [provisionedByUserId], references: [id], onDelete: Restrict)
  revokedBy          User?     @relation("EmployeeBadgeRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  mobileAuthAuditEvents MobileAuthAuditEvent[] @relation("MobileAuthAuditEventBadgeCredential")

  @@index([groupId], map: "employee_badge_credentials_group_id_idx")
  @@index([companyId], map: "employee_badge_credentials_company_id_idx")
  @@index([locationId], map: "employee_badge_credentials_location_id_idx")
  @@index([employeeId], map: "employee_badge_credentials_employee_id_idx")
  @@index([deviceId], map: "employee_badge_credentials_device_id_idx")
  @@index([revokedAt], map: "employee_badge_credentials_revoked_at_idx")
  @@index([lockedUntil], map: "employee_badge_credentials_locked_until_idx")
  @@unique([companyId, badgeUidHash], map: "employee_badge_credentials_company_id_badge_uid_hash_key")
  @@map("employee_badge_credentials")
}

model MobileAuthAuditEvent {
  id                  String                 @id @default(cuid())
  groupId             String?
  companyId           String?
  locationId          String?
  actorUserId         String?
  employeeId          String?
  deviceId            String?
  sessionId           String?
  enrollmentTokenId   String?
  badgeCredentialId   String?
  action              MobileAuthAuditAction
  outcome             MobileAuthAuditOutcome
  reason              String?
  /// Sanitized structured metadata only; never store raw tokens, raw Android IDs, raw badge UIDs, secrets, or customer data.
  metadata            Json?
  createdAt           DateTime               @default(now())

  group               Group?                 @relation("MobileAuthAuditEventGroup", fields: [groupId], references: [id], onDelete: SetNull)
  company             Company?               @relation("MobileAuthAuditEventCompany", fields: [companyId], references: [id], onDelete: SetNull)
  location            Location?              @relation("MobileAuthAuditEventLocation", fields: [locationId], references: [id], onDelete: SetNull)
  actorUser           User?                  @relation("MobileAuthAuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  employee            Employee?              @relation("MobileAuthAuditEventEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  device              MobileDevice?          @relation("MobileAuthAuditEventDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  session             MobileSession?         @relation("MobileAuthAuditEventSession", fields: [sessionId], references: [id], onDelete: SetNull)
  enrollmentToken     MobileEnrollmentToken? @relation("MobileAuthAuditEventEnrollmentToken", fields: [enrollmentTokenId], references: [id], onDelete: SetNull)
  badgeCredential     EmployeeBadgeCredential? @relation("MobileAuthAuditEventBadgeCredential", fields: [badgeCredentialId], references: [id], onDelete: SetNull)

  @@index([groupId], map: "mobile_auth_audit_events_group_id_idx")
  @@index([companyId], map: "mobile_auth_audit_events_company_id_idx")
  @@index([locationId], map: "mobile_auth_audit_events_location_id_idx")
  @@index([actorUserId], map: "mobile_auth_audit_events_actor_user_id_idx")
  @@index([employeeId], map: "mobile_auth_audit_events_employee_id_idx")
  @@index([deviceId], map: "mobile_auth_audit_events_device_id_idx")
  @@index([action], map: "mobile_auth_audit_events_action_idx")
  @@index([outcome], map: "mobile_auth_audit_events_outcome_idx")
  @@index([createdAt], map: "mobile_auth_audit_events_created_at_idx")
  @@map("mobile_auth_audit_events")
}

model MobileAuthRateLimit {
  id             String                   @id @default(cuid())
  groupId        String?
  companyId      String?
  locationId     String?
  scope          MobileAuthRateLimitScope
  identifierHash String
  windowStart    DateTime
  attemptCount   Int                      @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  group          Group?                   @relation("MobileAuthRateLimitGroup", fields: [groupId], references: [id], onDelete: SetNull)
  company        Company?                 @relation("MobileAuthRateLimitCompany", fields: [companyId], references: [id], onDelete: SetNull)
  location       Location?                @relation("MobileAuthRateLimitLocation", fields: [locationId], references: [id], onDelete: SetNull)

  @@index([groupId], map: "mobile_auth_rate_limits_group_id_idx")
  @@index([companyId], map: "mobile_auth_rate_limits_company_id_idx")
  @@index([locationId], map: "mobile_auth_rate_limits_location_id_idx")
  @@index([scope], map: "mobile_auth_rate_limits_scope_idx")
  @@index([lockedUntil], map: "mobile_auth_rate_limits_locked_until_idx")
  @@unique([scope, identifierHash, windowStart], map: "mobile_auth_rate_limits_scope_identifier_hash_window_start_key")
  @@map("mobile_auth_rate_limits")
}
