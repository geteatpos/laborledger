DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/laborledger"
PLATFORM_SUPERADMIN_EMAIL=""
PLATFORM_SUPERADMIN_PASSWORD=""
PLATFORM_SUPERADMIN_NAME="Platform Superadmin"
# Owner password for `pnpm --filter @laborledger/database seed:tenants` (never commit a real value)
SEED_OWNER_PASSWORD=""
API_BASE_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_APP_NAME="LaborLedger"

# Storage root for uploaded vehicle photos (Slice B)
STORAGE_ROOT=/var/lib/laborledger/uploads

# OpenAI Vision for mechanic part identification (Slice D)
# Backend-only. Never exposed to client.
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o

# MiniMax-M3 vision for AI "Find part online" flow in admin mechanic orders
# (admin-side image identification + shopping link builder).
# Backend-only. Never exposed to client. Optional; without it the modal
# still works but shows search links using the existing part name.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_VISION_MODEL=MiniMax-M3

# Admin Next.js (server-side BFF to API)
# API_BASE_URL is read by apps/admin BFF routes.

# Optional email (console provider is default)
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# ADMIN_APP_URL="https://admin.mariosautodetail.com"
# AUTH_FROM_EMAIL="noreply@example.com"
# AUTH_FROM_NAME="LaborLedger"
# INVOICE_FROM_EMAIL="billing@example.com"
# INVOICE_FROM_NAME="LaborLedger Billing"
