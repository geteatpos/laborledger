{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "MEMORY.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny"
  },
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Accept": "application/json",
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "timeout": 30000
    }
  }
}
